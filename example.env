# Copy to .env and fill in your values:
#   cp example.env .env
#
# Load for local development:
#   source load-env.sh
#
# Docker Compose reads .env from the project root.

# --- Required (add to .env) ---
# OPENAI_API_KEY
# POSTGRES_USER
# POSTGRES_DB
# POSTGRES credential (standard Postgres Docker env — see README)
# SPRING_DATASOURCE_USERNAME   (same value as POSTGRES_USER)
# SPRING_DATASOURCE credential (same value as Postgres credential above)
# SPRING_DATASOURCE_URL          e.g. jdbc:postgresql://localhost:5432/your_db_name
#
# Docker Compose loads all of the above from .env via env_file.

# --- Optional (defaults below) ---
OPENAI_API_MODEL=gpt-4.1
OPENAI_API_URL=https://api.openai.com/v1/chat/completions
